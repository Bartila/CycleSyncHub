@using CycleSyncHub.Application.Commands.CreateBike;

@model CreateBikeCommand
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Bike</title>
    <link rel="stylesheet" href="~/css/styleCreate.css" />
</head>
<body>
    <h1>Create Bike</h1>
    <hr />
    <div class="row">
        <div class="col-md-4 offset-md-4">
            <form action="/Bike/Create" method="post">
                <div class="form-group mb-3">
                    <label class="control-label" asp-for="Model">Model</label>
                    <input class="form-control" type="text" asp-for="Model">
                    <span asp-validation-for="Model" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label"></label>
                    <select asp-for="Description" class="form-control">
                        <option value="">Select</option>
                        <option value="New">New</option>
                        <option value="Used">Used</option>
                    </select>
                    <span asp-validation-for="Description" class=" text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="TypeOfBike" class="control-label">Type</label>
                    <select asp-for="TypeOfBike" class="form-control">
                        <option value="">Select</option>
                        <option value="Road">Road</option>
                        <option value="Aero">Aero</option>
                        <option value="MTB">MTB</option>
                        <option value="Gravel">Gravel</option>
                        <option value="TT">TT</option>
                        <option value="E-bike">E-bike</option>
                    </select>
                    <span asp-validation-for="TypeOfBike" class=" text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Weight" class="control-label"></label>
                    <input asp-for="Weight" type="number" step="0.1" class="form-control" placeholder="kg" />
                    <span asp-validation-for="Weight" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Size" class="control-label"></label>
                    <select asp-for="Size" class="form-control">
                        <option value="">Select</option>
                        <option value="XS">XS</option>
                        <option value="S">S</option>
                        <option value="M">M</option>
                        <option value="L">L</option>
                        <option value="XL">XL</option>
                        <option value="XXL">XXL</option>
                    </select>
                    <span asp-validation-for="Size" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="GroupSet" class="control-label">GroupSet</label>
                    <select asp-for="GroupSet" class="form-control">
                        <option value="">Select</option>
                        <option value="Shimano">Shimano</option>
                        <option value="SRAM">SRAM</option>
                    </select>
                    <span asp-validation-for="Description" class=" text-danger"></span>
                </div>


                <div class="form-group mb-3 d-flex justify-content-center" style="gap: 10px;">
                    <input type="submit" value="Create"
                           class="btn btn-primary"
                           style="display: inline-block;
                        padding: 10px 20px;
                        font-size: 16px;
                        font-weight: bold;
                        color: #fff;
                        background-color: #007bff;
                        border: 2px solid #0056b3;
                        border-radius: 8px;
                        text-decoration: none;
                        transition: all 0.3s ease;">

                    <a asp-action="Index" style="display: inline-block;
                        padding: 10px 20px;
                        font-size: 16px;
                        font-weight: bold;
                        color: #fff;
                        background-color: #007bff;
                        border: 2px solid #0056b3;
                        border-radius: 8px;
                        text-decoration: none;
                        transition: all 0.3s ease;">
                             Back to List
                    </a>
                </div>

            </form>
            

        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>
