@using CycleSyncHub.Application.BikeInfo.Commands.CreateInfo
@model CycleSyncHub.Application.Bike.BikeDto

@{
    ViewData["Title"] = "Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Bike Details</title>
    <link rel="stylesheet" href="~/css/styleDetails.css" />
</head>
<body>
    <h1>@Model.Model Details</h1>

    <div class="details-container">
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Model)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Model)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Description)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.TypeOfBike)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.TypeOfBike)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Weight) 
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Weight) kg
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Size)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Size)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.GroupSet)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.GroupSet)
            </dd>
        </dl>
    </div>

    <h3 class="mt-3">Infos:</h3>

    <div id="infos" class="row" data-encoded-name="@Model.EncodedName"></div>
    @* <div><partial name="_CreateBikeInfo" model="new CreateBikeInfoCommand() { BikeEncodedName = Model.EncodedName }"/></div> *@


    <div class="mt-3">
        <a class="btn btn-outline-secondary" asp-controller="Bike" asp-action="Edit" asp-route-encodedName="@Model.EncodedName">Edit</a>
        <a class="btn btn-back" asp-action="Index">Back to List</a>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script src="~/js/Bike/Details.js"></script> 
    }
</body>
</html>
