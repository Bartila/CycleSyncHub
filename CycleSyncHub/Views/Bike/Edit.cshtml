@using CycleSyncHub.Application.BikeInfo.Commands.CreateInfo
@model CycleSyncHub.Application.Bike.Commands.EditBike.EditBikeCommand

@{
    ViewData["Title"] = "Edit Bike";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Edit Bike</title>
    <link rel="stylesheet" href="~/css/styleDetails.css" />
</head>
<body>
    <h1>Edit @Model.Model</h1>

    <div class="edit-container">
        <form asp-action="Edit" method="post">
            <div class="form-group mb-3">
                <label asp-for="Model" class="control-label"></label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <select asp-for="Description" class="form-control">
                    <option value="">Select</option>
                    <option value="New">New</option>
                    <option value="Used">Used</option>
                </select>
                <span asp-validation-for="Description" class=" text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TypeOfBike" class="control-label">Type</label>
                <select asp-for="TypeOfBike" class="form-control">
                    <option value="">Select</option>
                    <option value="Road">Road</option>
                    <option value="Aero">Aero</option>
                    <option value="MTB">MTB</option>
                    <option value="Gravel">Gravel</option>
                    <option value="TT">TT</option>
                    <option value="E-bike">E-bike</option>
                </select>
                <span asp-validation-for="TypeOfBike" class=" text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Weight" class="control-label"></label>
                <input asp-for="Weight" type="number" step="0.1" class="form-control" placeholder="kg" />
                <span asp-validation-for="Weight" class="text-danger"></span>
            </div>


            <div class="form-group mb-3">
                <label asp-for="Size" class="control-label"></label>
                <select asp-for="Size" class="form-control">
                    <option value="">Select</option>
                    <option value="XS">XS</option>
                    <option value="S">S</option>
                    <option value="M">M</option>
                    <option value="L">L</option>
                    <option value="XL">XL</option>
                    <option value="XXL">XXL</option>
                </select>
                <span asp-validation-for="Size" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="GroupSet" class="control-label">GroupSet</label>
                <select asp-for="GroupSet" class="form-control">
                    <option value="">Select</option>
                    <option value="Shimano">Shimano</option>
                    <option value="SRAM">SRAM</option>
                </select>
                <span asp-validation-for="Description" class=" text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="hidden" asp-for="EncodedName" />
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>


    <h3>Infos:</h3>

    <div id="infos" class="row" data-encoded-name="@Model.EncodedName"></div>
    <div><partial name="_CreateBikeInfo" model="new CreateBikeInfoCommand() { BikeEncodedName = Model.EncodedName }" /></div>
    <div class="mt-3">
        <a class="btn btn-back" asp-action="Index">Back to List</a>
    </div>
    

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script src="~/js/Details.js"></script>
        <script src="~/js/Bike/Edit.js"></script>
    }
</body>
</html>
